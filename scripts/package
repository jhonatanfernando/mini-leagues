#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p infra/artifacts
(cd lambda && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o bootstrap .)
chmod 755 lambda/bootstrap
rm -f infra/artifacts/function.zip
zip -j infra/artifacts/function.zip lambda/bootstrap
python3 - <<'PY'
import stat
import zipfile
with zipfile.ZipFile('infra/artifacts/function.zip') as archive:
    assert archive.namelist() == ['bootstrap'], 'ZIP must contain only bootstrap at its root'
    info = archive.getinfo('bootstrap')
    assert stat.S_IMODE(info.external_attr >> 16) & 0o111 == 0o111, 'bootstrap must be executable'
    assert archive.testzip() is None, 'ZIP integrity check failed'
    with archive.open(info) as binary:
        header = binary.read(20)
    assert header[:4] == b'\x7fELF' and header[4:6] == b'\x02\x01' and header[18:20] == b'\x3e\x00', 'expected Linux amd64 ELF'
print('Verified ZIP root, executable permissions, integrity, and amd64 ELF.')
PY
