# Public browser settings from Terraform's web_auth and create_league_url outputs.
# VITE_API_URL is the API stage URL without /leagues or a trailing slash.
VITE_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/your-pool-id
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-2.amazoncognito.com
VITE_API_URL=https://your-api.execute-api.us-east-2.amazonaws.com/dev
