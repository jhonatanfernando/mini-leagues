{
  "name": "podium-picks-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "check": "tsc --noEmit",
