    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0"
  }
}
