# Copy to terraform.tfvars (ignored); match the reviewed backend account.
account_id = "123456789012"

# Defaults preserve existing resource names and runtime settings.
region                     = "us-east-2"
environment                = "dev"
owner                      = "jhonatan.oliveira"
log_retention_days         = 7
lambda_memory_mb           = 128
lambda_timeout_seconds     = 10
api_throttling_burst_limit = 5
api_throttling_rate_limit  = 2

# These register destinations only; the web callback is a future implementation.
auth_callback_urls = ["http://localhost:5173/auth/callback"]
auth_logout_urls   = ["http://localhost:5173/"]
api_cors_origins   = ["http://localhost:5173"]

# After registering and verifying the organizer in this user pool, set its exact
# Cognito sub. Empty keeps league creation disabled until a reviewed update.
initial_organizer_sub = ""
